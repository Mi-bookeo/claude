[
 {
  "start": 0.1,
  "end": 2.08,
  "text": "Dos tiendas de moda en Tudela.",
  "who": "narradora"
 },
 {
  "start": 2.12,
  "end": 4.32,
  "text": "Dos calles muy distintas.",
  "who": "narradora"
 },
 {
  "start": 4.36,
  "end": 7.02,
  "text": "Carmen tiene su tienda en la avenida principal.",
  "who": "narradora"
 },
 {
  "start": 7.06,
  "end": 9.16,
  "text": "Pasa muchísima gente…",
  "who": "narradora"
 },
 {
  "start": 9.25,
  "end": 11.02,
  "text": "…pero casi nadie entra.",
  "who": "narradora"
 },
 {
  "start": 11.06,
  "end": 13.49,
  "text": "María tiene la suya en una callejuela",
  "who": "narradora"
 },
 {
  "start": 13.53,
  "end": 15.3,
  "text": "donde casi no pasa nadie.",
  "who": "narradora"
 },
 {
  "start": 16.06,
  "end": 19.23,
  "text": "Y, sin embargo, siempre la tiene llena.",
  "who": "narradora"
 },
 {
  "start": 20.06,
  "end": 22.02,
  "text": "Porque ya no basta con que te vean.",
  "who": "narradora"
 },
 {
  "start": 22.06,
  "end": 24.44,
  "text": "Tienen que saber que existes.",
  "who": "narradora"
 },
 {
  "start": 25.06,
  "end": 27.59,
  "text": "María publica sus novedades y ofertas",
  "who": "narradora"
 },
 {
  "start": 27.63,
  "end": 29.37,
  "text": "en Escaparate de Tudela.",
  "who": "narradora"
 },
 {
  "start": 30.06,
  "end": 32.96,
  "text": "Y llegan directamente a la mano de sus clientes.",
  "who": "narradora"
 },
 {
  "start": 33.0,
  "end": 35.82,
  "text": "¿Pero adónde va todo el mundo?",
  "who": "carmen"
 },
 {
  "start": 35.86,
  "end": 39.05,
  "text": "Escaparate de Tudela hace que tu comercio exista.",
  "who": "narradora"
 },
 {
  "start": 39.09,
  "end": 40.31,
  "text": "Si tienes un comercio,",
  "who": "narradora"
 },
 {
  "start": 40.35,
  "end": 43.39,
  "text": "comenta ALTA y te enviamos la solicitud.",
  "who": "narradora"
 },
 {
  "start": 43.46,
  "end": 45.053,
  "text": "Y me han dicho que es gratis",
  "who": "maria"
 },
 {
  "start": 45.093,
  "end": 47.027,
  "text": "hasta el 31 de enero.",
  "who": "maria"
 }
]